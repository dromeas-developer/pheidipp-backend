APP_NAME=pheidipp-backend
ENVIRONMENT=test
DEBUG=true
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/test_pheidipp
LOG_LEVEL=INFO

# Object storage — MinIO (S3-compatible)
# Cleared for test env: ObjectStorageClient uses local fallback when
# endpoint/credentials are all empty. S3-specific tests mock boto3 directly.
# S3_ENDPOINT_URL=http://minio:9000
# S3_BUCKET=pheidipp-fit-files-test
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_USE_SSL=false

# Task queue — procrastinate (PostgreSQL-backed)
PROCRASTINATE_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/test_pheidipp

JWT_SECRET_KEY=test-secret-key-not-for-production-32bytes!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=pheidipp-test

LITELLM_BASE_URL=http://litellm:4000/v1
LLM_MODEL=cohere/command-a-plus